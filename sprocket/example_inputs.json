  "ResolveOmeDnaWorkflow.chrom_len_file": "wdl_runtime/refs/freec_chrLen.fai",
  "ResolveOmeDnaWorkflow.snp_positions_vcf": "wdl_runtime/refs/freec_snp_positions/all_chrom.sites.vcf.gz",
