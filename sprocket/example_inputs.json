  "_comment_LINEAGE": "produced by setup.sh section 7",
  "ResolveOmeDnaWorkflow.sequoia_build_phylogeny_script": "wdl_runtime/tools/sequoia/Sequoia/build_phylogeny.R",
  "ResolveOmeDnaWorkflow.verify_lineage_r_script": "extra_methods/verify_lineage.R",
  "ResolveOmeDnaWorkflow.mpboot_binary": "wdl_runtime/tools/mpboot/mpboot-1.1.0-Linux/bin/mpboot",
  "_comment_EXTRA_METHODS": "these already exist in extra_methods/ -- never produced by setup.sh, just referenced",
  "ResolveOmeDnaWorkflow.make_region_chunks_script": "wdl/scripts/make_region_chunks.py",
  "ResolveOmeDnaWorkflow.mapd_qc_script": "extra_methods/mapd_qc.py",
  "ResolveOmeDnaWorkflow.cell_qc_gate_script": "extra_methods/cell_qc_gate.py",
  "ResolveOmeDnaWorkflow.fdr_estimate_script": "extra_methods/fdr_estimate.py",
  "ResolveOmeDnaWorkflow.artifact_panel_script": "extra_methods/artifact_panel.py",
  "ResolveOmeDnaWorkflow.phasing_summary_script": "extra_methods/phasing_summary.py",
  "ResolveOmeDnaWorkflow.loh_summary_script": "extra_methods/loh_summary.py",
  "ResolveOmeDnaWorkflow.ploidy_summary_script": "extra_methods/ploidy_summary.py",
  "ResolveOmeDnaWorkflow.loh_by_region_script": "extra_methods/loh_by_region.py",
  "ResolveOmeDnaWorkflow.qc_summary_script": "extra_methods/qc_summary.py",
  "ResolveOmeDnaWorkflow.mutational_signatures_r_script": "extra_methods/mutational_signatures.R",
  "ResolveOmeDnaWorkflow.lineage_track_script": "extra_methods/lineage_track.py",
  "ResolveOmeDnaWorkflow.verify_lineage_script": "extra_methods/verify_lineage.py",
  "ResolveOmeDnaWorkflow.build_dashboard_script": "extra_methods/build_extra_dashboard.py",
  "_comment_SPROCKET_CONTAINERS": "replaces wdl/example_inputs.json's conda_env/freec_conda_env/r_conda_env String inputs -- these are the NEW container images this port needs (see ../README.md); all 4 are placeholders you must build (see containers/*.Dockerfile) and push yourself before running, OR override with a file:// path to a pre-pulled local .sif if you'd rather not use a registry",
  "ResolveOmeDnaWorkflow.resolveome_align_container": "docker://ghcr.io/zvaksmanSJ/scdna-workflow-resolveome-align:latest",
  "ResolveOmeDnaWorkflow.freec_container": "docker://ghcr.io/zvaksmanSJ/scdna-workflow-freec:latest",
  "ResolveOmeDnaWorkflow.lineage_container": "docker://ghcr.io/zvaksmanSJ/scdna-workflow-lineage:latest",
  "ResolveOmeDnaWorkflow.mutsig_container": "docker://ghcr.io/zvaksmanSJ/scdna-workflow-mutsig:latest",
  "ResolveOmeDnaWorkflow.manta_container": "docker://quay.io/biocontainers/manta:1.6.0--py27h9948957_6"
}
