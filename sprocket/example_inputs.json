{
  "_comment_1": "Example inputs.json for sprocket/main.wdl, the Sprocket-native port of the general-purpose WDL ResolveOME DNA workflow.",
  "_comment_2": "Every key must be prefixed 'ResolveOmeDnaWorkflow.<field>' -- same convention as the Cromwell version's wdl/example_inputs.json.",
  "_comment_3": "Paths below assume you ran ../setup/setup.sh with its default BASE_DIR (../wdl_runtime) AND built+pushed the 4 new container images under containers/*.Dockerfile (setup.sh does NOT do this for you -- see ../README.md).",
  "ResolveOmeDnaWorkflow.donor_id": "my_cohort",
  "ResolveOmeDnaWorkflow.gender": "male",
  "_comment_FASTQS": "THIS IS THE 'LIST OF FASTQS' PART -- the 3 arrays below must be the SAME LENGTH and in the SAME ORDER: sample_ids[i] / r1_fastqs[i] / r2_fastqs[i] all describe the same cell.",
  "ResolveOmeDnaWorkflow.sample_ids": [
    "cell1",
    "cell2",
    "cell3"
  ],
  "ResolveOmeDnaWorkflow.r1_fastqs": [
    "/path/to/fastqs/cell1_R1.fastq.gz",
    "/path/to/fastqs/cell2_R1.fastq.gz",
    "/path/to/fastqs/cell3_R1.fastq.gz"
  ],
  "ResolveOmeDnaWorkflow.r2_fastqs": [
    "/path/to/fastqs/cell1_R2.fastq.gz",
    "/path/to/fastqs/cell2_R2.fastq.gz",
    "/path/to/fastqs/cell3_R2.fastq.gz"
  ],
  "_comment_REFERENCE": "produced by setup.sh section 2",
  "ResolveOmeDnaWorkflow.ref_fasta": "wdl_runtime/refs/genome/GRCh38.primary.fa",
  "ResolveOmeDnaWorkflow.ref_fasta_fai": "wdl_runtime/refs/genome/GRCh38.primary.fa.fai",
  "ResolveOmeDnaWorkflow.ref_fasta_dict": "wdl_runtime/refs/genome/GRCh38.primary.dict",
  "ResolveOmeDnaWorkflow.ref_bwamem2_0123": "wdl_runtime/refs/genome/GRCh38.primary.fa.0123",
  "ResolveOmeDnaWorkflow.ref_bwamem2_bwt2bit64": "wdl_runtime/refs/genome/GRCh38.primary.fa.bwt.2bit.64",
  "ResolveOmeDnaWorkflow.ref_bwamem2_ann": "wdl_runtime/refs/genome/GRCh38.primary.fa.ann",
  "ResolveOmeDnaWorkflow.ref_bwamem2_amb": "wdl_runtime/refs/genome/GRCh38.primary.fa.amb",
  "ResolveOmeDnaWorkflow.ref_bwamem2_pac": "wdl_runtime/refs/genome/GRCh38.primary.fa.pac",
  "ResolveOmeDnaWorkflow.metrics_intervals_bed": "wdl_runtime/refs/genome/GRCh38.primary.fa.fai",
  "_comment_metrics_bed": "^ a real deployment should supply its own BED of regions of interest here; the .fai is only a placeholder that happens to be a valid file",
  "_comment_DEEPVARIANT": "the free default path -- deepvariant_model_dir_tar/population_vcfs_tar intentionally omitted",
  "ResolveOmeDnaWorkflow.dv_use_allele_frequency": false,
  "ResolveOmeDnaWorkflow.deepvariant_container": "docker://google/deepvariant:1.6.1",
  "ResolveOmeDnaWorkflow.chroms": "all",
  "_comment_VEP": "produced by setup.sh section 4",
